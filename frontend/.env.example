# Copy this file to .env.local for local development overrides.
# Values here are injected at Vite build time via import.meta.env.
# NEVER commit .env.local with real values.

# Full URL of the deployed backend API — no trailing slash
VITE_API_URL=https://localhost:44385

# Full URL of the SignalR hub endpoint
VITE_SIGNALR_URL=https://localhost:44385/hubs/orders
